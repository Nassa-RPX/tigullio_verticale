---
import { PortableText } from "astro-portabletext";

import Layout from "@/layouts/Layout.astro";
import EventContent from "@/components/Event.astro";
import GoBack from "@/components/GoBack/GoBack.astro";
import { sanityClient, type DateDoc } from "@/lib/sanity";

export async function getStaticPaths() {
  const dates: Array<DateDoc> = await sanityClient.fetch(`
    *[_type == "appuntamento"] {
      "year": programYear->year,
      "slug": slug.current,
      "program": programYear->{ year, title },
      date,
      title,
      location,
      timeInfo,
      body
    }
  `);
  return dates.map((date: any) => ({
    params: { year: date.year.toString(), slug: date.slug },
    props: { date },
  }));
}

const { date } = Astro.props;

const events = await sanityClient.fetch(
  `
  *[_type == "event" && date->slug.current == $dateSlug] | order(_createdAt asc) {
    "slug": slug.current,
    title,
    location,
    info,
    hasDescription,
    requiredPrenotation,
    body
  }
`,
  { dateSlug: date.slug },
);
const hasMultipleEvents = events.length > 1;
---

<Layout title={`${date.title}`}>
  <div class="top-space"></div>
  <section class="page">
    <div class="page-title-container gsapped-in">
      <GoBack id="event-go-back" href={`/programma/${date.year}`} />
      <h1 id="program-year" class="page-title">{date.title}</h1>

      {
        hasMultipleEvents && (
          <div class="date-multiple-info">
            <span>{new Date(date.date).toLocaleDateString("it-IT")}</span>
            <span>{date.location}</span>
          </div>
        )
      }
    </div>

    <div class="date-description gsapped-in">
      <PortableText value={date.body} />
    </div>

    {
      events.map((event: any) => (
        <div class="card inverted gsapped-in">
          <span class="card-info important">
            {" "}
            {event.info} {!hasMultipleEvents && `| ${date.location}`}{" "}
          </span>
          <h2 class:list={["card-title", { multiple: hasMultipleEvents }]}> {event.title} </h2>
          {event.hasDescription && <EventContent body={event.body} />}
        </div>
      ))
    }
  </section>
</Layout>

<script src="@/scripts/event.script.ts"></script>

<style scoped>
  .date-description {
    text-align: center;
  }

  .date-multiple-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    font-weight: bold;
    font-size: 1.1rem;
  }
</style>
