---
import { PortableText } from "astro-portabletext";
import Layout from "@/layouts/Layout.astro";
import EditorialDetails from "@/components/EditorialDetails.astro";
import PracticalInformation from "@/components/PracticalInformation.astro";
import NewEventDetails from "@/components/NewEventDetails.astro";
import EventSidebar from "@/components/EventSidebar.astro";
import EventType from "@/components/EventType.astro";
import EventDateRange from "@/components/EventDateRange.astro";
import { getContent, type DateDoc, type LegacyRoute } from "@/lib/sanity";
export async function getStaticPaths() {
  const { dates, legacyRoutes } = await getContent();
  const paths = dates.map((date) => ({ params: { year: String(date.year), slug: date.slug }, props: { date } }));
  const existing = new Set(dates.map((date) => `${date.year}/${date.slug}`));
  return [
    ...paths,
    ...legacyRoutes
      .filter((route) => !existing.has(`${route.year}/${route.slug}`))
      .map((legacyRoute) => ({
        params: { year: String(legacyRoute.year), slug: legacyRoute.slug },
        props: { legacyRoute },
      })),
  ];
}
interface Props {
  date?: DateDoc;
  legacyRoute?: LegacyRoute;
}
const { legacyRoute } = Astro.props;
const { dates } = await getContent();
const targets = legacyRoute ? dates.filter((item) => legacyRoute.targetIds.includes(item._id)) : [];
if (legacyRoute && !targets.length) throw new Error("Missing legacy route targets.");
const date: DateDoc = Astro.props.date || { ...targets[0], title: legacyRoute!.title, slug: legacyRoute!.slug };
const related = dates.filter((item) => item.year === date.year && item._id !== date._id);
const eventBooking =
  date.kind === "series" ? (date.series?.bookingMode === "series" ? date.series.booking : undefined) : date.booking;
const hasSessionBooking =
  date.kind === "series" &&
  date.series?.bookingMode === "sessions" &&
  date.series.meetings.some((slot) => slot.booking?.required);
const hasDescription = !!date.body?.length || date.events.some((event) => event.hasDescription && event.body?.length);

console.log("legacyRoute", legacyRoute);
---

<Layout title={date.title} description={date.summary || date.subtitle || undefined}>
  <div class:list={["container", "event-layout", "event-layout--detail", { "event-layout--overview": !!legacyRoute }]}>
    <div class="event-main">
      <section class="page-hero">
        <div class="page-hero__inner">
          <a class="back" href={`/programma/${date.year}`}
            ><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow-left"></use></svg><span
              >Programma {date.year}</span
            ></a
          >
          {!legacyRoute && <EventType kind={date.kind} />}
          <h1 class="display-l">{date.title}</h1>

          {!date.kind && date.subtitle && <p class="lede">{date.subtitle}</p>}
          <div class="event-meta">
            <EventDateRange date={date.date} endDate={legacyRoute ? undefined : date.endDate} />
            {
              !legacyRoute && date.timeInfo && (
                <span class="event-meta__info">
                  {date.kind === "walk" ? "Ritrovo" : "Ore"} {date.timeInfo}
                </span>
              )
            }
            <span class="event-meta__place">{date.location}</span>
          </div>
          <!-- {
            !legacyRoute && eventBooking?.required && (
              <a class="event-booking-link" href="#prenotazione-evento">
                Prenotazione obbligatoria <span aria-hidden="true">↓</span>
              </a>
            )
          } -->
          {
            !legacyRoute && hasSessionBooking && (
              <a class="event-booking-link" href="#incontri">
                Prenotazione dei singoli incontri <span aria-hidden="true">↓</span>
              </a>
            )
          }
        </div>
      </section>
      {
        legacyRoute && (
          <section class="section section--tight-top">
            <div class="event-body">
              <p>Scopri gli eventi di questa giornata.</p>
              {targets.map((target) => (
                <section
                  class="event-section"
                  id={`activity-${legacyRoute.anchors.find((anchor) => anchor.targetId === target._id)?.oldId || target._id}`}
                >
                  <EventType kind={target.kind} />
                  <h2 class="event-section__title">
                    <a href={`/programma/${target.year}/${target.slug}`}>{target.title}</a>
                  </h2>
                  <p>{target.summary}</p>
                  <a class="link-arrow" href={`/programma/${target.year}/${target.slug}`}>
                    Scopri l’evento
                  </a>
                </section>
              ))}
            </div>
          </section>
        )
      }
      {
        !legacyRoute && date.kind && (
          <section class="section section--tight-top">
            <NewEventDetails event={date} />
          </section>
        )
      }
      {
        !legacyRoute && !date.kind && (
          <section class="section section--tight-top">
            <div class="event-body">
              {!!date.body?.length && (
                <div class="prose">
                  <PortableText value={date.body} />
                </div>
              )}
              <PracticalInformation info={date.practicalInfo} />
              <EditorialDetails content={date} />
              {date.events.map((event) => (
                <section class="event-section" id={`activity-${event._id}`}>
                  <h2 class="event-section__title">{event.title}</h2>
                  {event.subtitle && <p class="event-lede">{event.subtitle}</p>}
                  {(event.location || event.info) && (
                    <p class="event-meta__info">{[event.location, event.info].filter(Boolean).join(" · ")}</p>
                  )}
                  {event.requiredPrenotation && <span class="badge-next">Prenotazione obbligatoria</span>}
                  {event.hasDescription && !!event.body?.length && (
                    <div class="prose">
                      <PortableText value={event.body} />
                    </div>
                  )}
                  <PracticalInformation
                    info={event.practicalInfo}
                    title={event.title}
                    required={event.requiredPrenotation}
                  />
                  <EditorialDetails content={event} />
                </section>
              ))}
              {!hasDescription && <p class="muted">Descrizione dettagliata in arrivo.</p>}
            </div>
          </section>
        )
      }
    </div>
    {!legacyRoute && <EventSidebar event={date} related={related} />}
  </div>
</Layout>
