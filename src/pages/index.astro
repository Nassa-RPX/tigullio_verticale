---
import Layout from "@/layouts/Layout.astro";
import AppointmentList from "@/components/AppointmentList.astro";
import FeaturedAppointment from "@/components/FeaturedAppointment.astro";
import NewsletterForm from "@/components/NewsletterForm.astro";
import Logo from "@/components/Logo.astro";
import { getContent } from "@/lib/sanity";
import { activeSeason, splitDates } from "@/lib/calendar";
const { programs, dates } = await getContent();
const season = activeSeason(programs, dates);
const next = splitDates(dates).upcoming[0];
---

<Layout title="Home">
  <section class="hero" data-home-motion>
    <div class="contour-wrap" aria-hidden="true">
      <svg class="contour" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice"
        ><use href="#contour-band"></use></svg
      >
    </div>
    <div class="hero__inner">
      <div class="hero__logo" aria-hidden="true">
        <Logo />
      </div>
      <h1 class="hero__wordmark">Tigullio<br />Verticale</h1>
      <div class="hero__cta">
        <a class="btn btn--solid btn--lg" href={season ? `/programma/${season}` : "/programma"} data-current-program>
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-book-open"></use></svg>
          Programma <span data-season-year>{season ?? ""}</span>
        </a>
        <a class="btn btn--outline btn--lg" href="/newsletter">Iscriviti alla newsletter</a>
      </div>
    </div>
    <a class="hero__scroll" href="#idea" data-home-scroll aria-label="Scorri alla sezione L’idea"
      >Scorri <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow-down"></use></svg></a
    >
  </section>

  <section class="section idea-editorial" id="idea" tabindex="-1" data-home-reveal>
    <div class="container idea-editorial__inner">
      <header class="idea-editorial__head">
        <span class="kicker">L’idea</span>
        <h2 class="idea-editorial__title">Due meta'.<br /><span>Un solo paesaggio.</span></h2>

        <div class="idea-axis" aria-label="La relazione fra costa ed entroterra">
          <span class="idea-axis__place">Costa</span>
          <span class="idea-axis__line" aria-hidden="true">
            <span class="idea-axis__mark"><svg viewBox="0 0 124 131"><use href="#tv-mark"></use></svg></span>
          </span>
          <span class="idea-axis__place">Entroterra</span>
        </div>
      </header>

      <div class="idea-editorial__body">
        <p class="idea-editorial__intro">
          Il Tigullio è conosciuto per il suo mare. Molto meno si parla dell’entroterra che da sempre lo tiene in piedi.
        </p>
        <p class="idea-editorial__intro">
          <strong>Tigullio Verticale</strong> mette in relazione queste due metà. Organizza appuntamenti che attraversano
          il territorio dalla costa alle valli per guardarlo da vicino, riconoscerlo e raccontarlo.
        </p>

        <blockquote class="idea-editorial__quote">Riscoprire la relazione fra il territorio e chi lo abita.</blockquote>
      </div>
    </div>
  </section>

  <section class="section section--tight" data-home-reveal>
    <div class="container">
      <div class="section-head">
        <span class="kicker" data-feature-label>{next ? "Prossimo appuntamento" : "Restiamo in cammino"}</span>
      </div>{dates.map((date) => <FeaturedAppointment date={date} hidden={date._id !== next?._id} />)}<div
        class="panel panel--fill"
        data-feature-empty
        hidden={!!next}
      >
        <h2 class="display-s">Prossimo programma in arrivo</h2><p class="muted">
          Iscriviti alla newsletter per non perderlo.
        </p><a class="btn btn--outline" href="/newsletter">Iscriviti alla newsletter</a>
      </div>
    </div>
  </section>

  <section class="section" data-home-reveal>
    <div class="container">
      <div class="section-head section-head--row">
        <div class="section-head__text">
          <span class="kicker">Stagione</span>
          <h2 class="display-m">Programma <span data-season-year>{season ?? ""}</span></h2>
        </div>
        <a class="link-arrow" href={season ? `/programma/${season}` : "/programma"} data-current-program
          >Tutto il programma
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
        </a>
      </div>
      {
        programs.map((program) => (
          <div data-home-season data-season={program.year} hidden={program.year !== season}>
            <AppointmentList dates={dates.filter((date) => date.year === program.year)} preview />
          </div>
        ))
      }{
        !programs.length && (
          <p class="muted">Il programma è in preparazione. Iscriviti alla newsletter per ricevere le nuove date.</p>
        )
      }
    </div>
  </section>

  <section class="section section--tight-top" data-home-reveal>
    <div class="container">
      <div class="section-head">
        <span class="kicker">Come lavoriamo</span>
        <p class="lede">
          Ogni appuntamento nasce da un modo preciso di stare sul territorio: camminarlo, riconoscerlo, raccontarlo e
          immaginarlo di nuovo abitato.
        </p>
      </div>
      <div class="grid grid--4">
        <div class="feature">
          <span class="feature__icon" aria-hidden="true"
            ><svg viewBox="0 0 24 24"><use href="#i-footprints"></use></svg></span
          >
          <h3>Camminare</h3>
          <p>Percorsi a piedi che collegano la costa all’entroterra, lungo sentieri e passaggi poco frequentati.</p>
        </div>
        <div class="feature">
          <span class="feature__icon" aria-hidden="true"
            ><svg viewBox="0 0 24 24"><use href="#i-compass"></use></svg></span
          >
          <h3>Riconoscere</h3>
          <p>Ogni tappa parte dalla lettura del paesaggio: cosa cambia, cosa resta, chi lo abita e come.</p>
        </div>
        <div class="feature">
          <span class="feature__icon" aria-hidden="true"
            ><svg viewBox="0 0 24 24"><use href="#i-book-open"></use></svg></span
          >
          <h3>Raccontare</h3>
          <p>Restituiamo quello che vediamo: storie, incontri e materiali raccolti camminando insieme.</p>
        </div>
        <div class="feature">
          <span class="feature__icon" aria-hidden="true"
            ><svg viewBox="0 0 24 24"><use href="#i-sprout"></use></svg></span
          >
          <h3>Riabitare</h3>
          <p>
            Guardiamo alle pratiche di chi torna a vivere e coltivare le valli, per immaginare un entroterra abitato.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band section" data-home-reveal>
    <div class="contour-wrap" aria-hidden="true">
      <svg class="contour" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice"
        ><use href="#contour-band"></use></svg
      >
    </div>
    <div class="container band__inner">
      <div class="section-head__text">
        <span class="kicker">Newsletter</span>
        <h2 class="display-m">Restiamo in cammino</h2>
        <p class="lede">
          Nuove date, racconti dal territorio e inviti agli appuntamenti. Ti scriviamo solo quando c’è qualcosa da
          raccontare.
        </p>
      </div>
      <div>
        <NewsletterForm compact id="home" />
      </div>
    </div>
  </section>
</Layout>
<script src="@/scripts/home/motion.ts"></script>
<style>
  .hero__logo :global(svg) { overflow: visible; }
  .hero__scroll {
    padding: 0.5rem;
    border-radius: 0.25rem;
    transition: color 0.2s ease;
  }
  .hero__scroll:hover {
    color: var(--fg);
  }
  #idea {
    scroll-margin-top: 0;
  }
</style>
