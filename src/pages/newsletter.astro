---
import Layout from "@/layouts/Layout.astro";
import NewsletterForm from "@/components/NewsletterForm.astro";
---

<Layout title="Newsletter">
  <section class="page-hero" data-newsletter-motion>
    <div class="contour-wrap" aria-hidden="true">
      <svg class="contour" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice"
        ><use href="#contour-band"></use></svg
      >
    </div>
    <div class="container page-hero__inner">
      <span class="kicker">Newsletter</span>
      <h1 class="display-l">Resta in cammino</h1>
      <p class="lede">
        Iscriviti per ricevere le nuove date, i racconti dal territorio e gli inviti agli appuntamenti fra costa ed
        entroterra.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container split split--wide-left">
      <div class="section-head__text" data-newsletter-benefits>
        <span class="kicker">Cosa ricevi</span>
        <!-- <h2 class="display-m">Poche email, tutte utili</h2> -->
        <ul class="grid" style="list-style:none;gap:1.1rem;margin-top:.6rem">
          <li class="feature">
            <span class="feature__icon" aria-hidden="true"
              ><svg viewBox="0 0 24 24"><use href="#i-calendar"></use></svg></span
            >
            <h3>Nuove date</h3>
            <p>Il nuovo programma e ogni appuntamento, appena viene definito.</p>
          </li>
          <li class="feature">
            <span class="feature__icon" aria-hidden="true"
              ><svg viewBox="0 0 24 24"><use href="#i-book-open"></use></svg></span
            >
            <h3>Racconti dalle camminate</h3>
            <p>Storie, luoghi e incontri raccolti lungo i sentieri del Tigullio.</p>
          </li>
          <li class="feature">
            <span class="feature__icon" aria-hidden="true"
              ><svg viewBox="0 0 24 24"><use href="#i-mail"></use></svg></span
            >
            <h3>Inviti diretti</h3>
            <p>Un promemoria prima di ogni appuntamento in programma.</p>
          </li>
        </ul>
      </div>

      <div>
        <div class="panel panel--fill" style="gap:1.4rem" data-newsletter-form-panel>
          <NewsletterForm id="full" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section">
    <div class="container">
      <div
        class="panel"
        style="flex-direction:row;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap"
        data-newsletter-program
      >
        <div class="section-head__text" style="gap:.4rem">
          <h2 class="display-s">Preferisci iniziare dal programma?</h2>
          <p class="muted">Guarda gli appuntamenti delle stagioni 2026 e 2025.</p>
        </div>
        <a class="btn btn--outline btn--lg" href="/programma">Vai al programma</a>
      </div>
    </div>
  </section>
</Layout>
<script src="@/scripts/newsletter-motion.ts"></script>
<style>
  .page-hero[data-newsletter-motion] .page-hero__inner > * {
    animation: none;
  }
</style>
