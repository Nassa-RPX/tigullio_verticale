---
import type { Program, DateDoc } from "@/lib/sanity";
import AppointmentList from "@/components/appointments/AppointmentList.astro";
import Contour from "@/components/ui/Contour.astro";
interface Props {
  programs: Program[];
  dates: DateDoc[];
  selected?: number;
}
const { programs, dates, selected } = Astro.props;
const program = programs.find((program) => program.year === selected);
---

<section class="page-hero" data-program-motion>
  <Contour /><div class="container page-hero__inner">
    <span class="kicker">Camminate · Incontri · Festival</span><h1 class="display-l">
      {program?.title || (selected ? `Programma ${selected}` : "Il programma")}
    </h1><p class="lede">
      Occasioni per attraversare il territorio, incontrare chi lo conosce e ascoltare nuove voci. Gli eventi già svolti
      restano in archivio.
    </p>
  </div>
</section>
<section class="section section--tight" data-program-list>
  <div class="container">
    <div class="section-head section-head--row" data-program-years>
      <div class="section-head__text">
        <span class="kicker">Stagioni</span><h2 class="display-m">Scegli l’anno</h2>
      </div><nav class="tabs" aria-label="Stagioni del programma">
        {
          programs.map((program) => (
            <a
              class="tab"
              href={`/programma/${program.year}`}
              aria-current={program.year === selected ? "page" : undefined}
            >
              {program.year}
            </a>
          ))
        }
      </nav>
    </div>
    {
      selected !== undefined ? (
        <div class="season-panel">
          <>
            <h2 class="visually-hidden">Programma {selected}</h2>
            <AppointmentList dates={dates.filter((date) => date.year === selected)} />
          </>
        </div>
      ) : (
        <p class="muted">Il programma è in preparazione. Iscriviti alla newsletter per ricevere le nuove date.</p>
      )
    }
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="panel panel--fill program-cta" data-program-cta>
      <div class="section-head__text">
        <h2 class="display-s">Vuoi sapere quando escono le nuove date?</h2><p class="muted">
          Iscriviti alla newsletter: ti avvisiamo a ogni nuovo evento.
        </p>
      </div><a class="btn btn--outline" href="/newsletter">Iscriviti alla newsletter</a>
    </div>
  </div>
</section>
<script src="@/scripts/program-motion.ts"></script>
<style>
  [data-program-list] :global(.event-card) {
    opacity: calc(var(--program-card-opacity, 1) * var(--program-card-reveal, 1));
  }
  [data-program-list] :global(.event-card--past) {
    --program-card-opacity: 0.72;
  }
  [data-program-list] :global(.event-card:hover) {
    --program-card-opacity: 1;
  }
</style>
