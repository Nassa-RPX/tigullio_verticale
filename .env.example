PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_API_VERSION=
# Public datasets can be built without a token. For private reads use a Viewer token.
SANITY_READ_TOKEN=
PUBLIC_KIT_SUBMIT_MODE=
PUBLIC_KIT_API=
# Vercel production is detected automatically. Other hosts: TV_ENV=production.
# A deliberate production compatibility build: TV_ENV=production-readonly,
# both dataset variables=main, and PUBLIC_KIT_SUBMIT_MODE=mock.
# Production deploy: PUBLIC_SANITY_DATASET=main and SANITY_STUDIO_DATASET=main.
# pnpm sanity:deploy selects the production Studio automatically; no TV_ENV flag is needed.
